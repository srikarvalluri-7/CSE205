// checking prime number

#include <iostream>
using namespace std;
bool isprime(int n){
    
    for(int i=2;i<n;i++){
        if(n%i==0){
            return false;
        }
        break;
    }
    return true;
}
int main(){
    int n;
    cin>>n;
    if(isprime(n)){
        cout<<"Prime";
    }
    else{
        cout<<"not prime";
    }
}


//finding palindrome or not
#include <iostream>
using namespace std;
bool ispalindrome(int n){
    int temp = n;
    int rev=0,d;
    for(;n>0;n/=10){
        d = n%10;
        rev = rev*10 + d;
    }
    if(temp==rev){
        return true;
    }
    else{
        return false;
    }
}
int main(){
    int n;
    cin>>n;
    if(ispalindrome(n)){
        cout<<"Palindrome";
    }
    else{
        cout<<"Not a Palindrome";
    }
}


//sum of first and last digit of the numbed.
#include <iostream>
using namespace std;
int reverse(int n){
    int temp = n;
    int rev=0,d;
    for(;n>0;n/=10){
        d = n%10;
        rev = rev*10 + d;
    }
    return rev;
}
int main(){
    int n;
    cin>>n;
    int l = n%10;
    int f = reverse(n)%10;
    int sum = f+l;
    cout<<sum;
}

//product of  digits of the number.
#include <iostream>
using namespace std;
int product(int n){
    int d;
    int product = 1;
    for(;n>0;n/=10){
        d = n%10;
        product*=d;
    }
    return product;
}
int main(){
    int n;
    cin>>n;
    cout<<product(n);
}

