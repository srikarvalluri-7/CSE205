//selection sort 
//time complexity = O(n^2)(all for best worst and avg cases)
#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 2, 8, 1, 3};
    int n = 5;
    //finding the minimum index
    for (int i = 0; i < n - 1; i++) {
        int minIndex = i;

        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[minIndex]) {
                minIndex = j;
            }
        }

        // Swaping 
        int temp = arr[i];
        arr[i] = arr[minIndex];
        arr[minIndex] = temp;
    }

    cout << "Sorted array: ";

    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}



//Insertion short := insert into sorted portion.
//time complexity = O(n^2) for worst and O(n) for best.
#include <iostream>
using namespace std;
int main(){
    int arr[10] = {2,3,1,5,7,4,9,10,8,6};
    int n = 10;
    int key;
    for(int i=1;i<=n-1;i++){
        key = arr[i];
        int j=i-1;
        while(j>=0 and arr[j]>key){
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=key;
    }
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
}

