#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    
    Node(int val) {
        data = val;
        next = nullptr;
    }
};

class LL {
public:
    Node* head;

    LL() {
        head = nullptr;
    }

    // Insert at front for demonstration
    void insertFront(int val) {
        Node* newNode = new Node(val);
        newNode->next = head;
        head = newNode;
    }

    void popfront() {
        if (head == nullptr) return;
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    bool search(int val) {
        Node* temp = head;
        while (temp != nullptr) {
            if (temp->data == val) {
                return true; // Value found
            }
            temp = temp->next;
        }
        return false; // Value not found
    }
};


//linked list.
int main() {
    LL list;

    // Add elements: 30 -> 20 -> 10
    list.insertFront(10);
    list.insertFront(20);
    list.insertFront(30);

    int target = 20;
    if (list.search(target)) {
        cout << "Element " << target << " found in the linked list." << endl;
    } else {
        cout << "Element " << target << " not found." << endl;
    }

    return 0;
}
