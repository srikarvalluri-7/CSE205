//find the missing number in the array of numbers from 1 to n(2nd approach).
#include <iostream>
using namespace std;

int main() {
    int arr[9] = {1, 2, 4, 5, 6, 7, 8, 9, 10};
    int n = 10;
    int miss = 0;
    for (int i = 1; i <= n; i++) {
        int flag = 0;
        for (int j = 0; j < n - 1; j++) {
            if (arr[j] == i) {
                flag = 1;
                break;
            }
        }
        if (flag == 0) {
            miss = i;
            break;
        }
    }
    cout << "Missing number: " << miss;
    return 0;
}


//find the missing number in the array of numbers from 1 to n(3rd approach).
#include <iostream>
using namespace std;
int missingNumberXOR(int arr[],int size){
    int x1=0;
    int x2=0;
    int n = size +1;
    for(int i=0;i<=n;i++){
        x1=x1^i;
    }
    for(int i=0;i<size;i++){
        x2=x2^arr[i];
    }
    return (x1^x2);
}
int main() {
    int arr[9] = {1, 2, 4, 5, 6, 7, 8, 9, 10};
    int n = 9;
    cout << "Missing number: " << missingNumberXOR(arr,n);
    return 0;
}


